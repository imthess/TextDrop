{
  "manifest_version": 3,
  "name": "TextDrop",
  "version": "1.2.1",
  "description": "Keep a list of text snippets and insert any of them into a text box with one click, even on sites that block copy and paste.",
  "permissions": ["storage", "unlimitedStorage", "scripting"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_start",
      "all_frames": true,
      "match_about_blank": true
    }
  ],
  "action": {
    "default_title": "TextDrop: manage your list",
    "default_popup": "popup.html"
  },
  "commands": {
    "toggle-panel": {
      "suggested_key": { "default": "Alt+Shift+V" },
      "description": "Open or close the on-page list"
    },
    "save-selection": {
      "suggested_key": { "default": "Alt+Shift+S" },
      "description": "Save the selected text to the list"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
